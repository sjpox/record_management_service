generator client {
  provider = "prisma-client"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlserver"
}

// Lookup Tables
model DocOrigins {
  Id       Int       @id @default(autoincrement())
  Origin   String    @db.NVarChar(255)
  InComms  InComms[]

  @@map("DocOrigins")
}

model ResponPersons {
  Id         Int         @id @default(autoincrement())
  Name       String      @db.NVarChar(255)
  ContactNo  String?     @db.NVarChar(50)
  IP_Add     String?     @db.NVarChar(50)
  Email      String?     @db.NVarChar(255)
  Department String?     @db.NVarChar(255)
  OutGoings  OutGoings[]

  @@map("ResponPersons")
}

model DocTypes {
  Id   Int    @id @default(autoincrement())
  Type String @db.NVarChar(255)

  @@map("DocTypes")
}

model Receivers {
  Id         Int    @id @default(autoincrement())
  Department String @db.NVarChar(255)

  @@map("Receivers")
}

model StockRooms {
  Id       Int    @id @default(autoincrement())
  RoomName String @db.NVarChar(255)

  @@map("StockRooms")
}

// Main Document Tables
model Vouchers {
  Id           Int         @id @default(autoincrement())
  VoucherNo    String      @db.NVarChar(50)
  TrackNo      String?     @db.NVarChar(50)
  Payee        String?     @db.NVarChar(255)
  Particulars  String?     @db.NVarChar(Max)
  Amount       Decimal?    @db.Decimal(18, 2)
  DateReleased DateTime?   @db.DateTime2
  Folder       String?     @db.NVarChar(255)
  RoomNo       String?     @db.NVarChar(50)
  DocTag       String?     @db.NVarChar(100)
  VouPhotos    VouPhotos[]

  @@map("Vouchers")
}

model InComms {
  Id           Int           @id @default(autoincrement())
  DateReceived String?       @db.NVarChar(50)
  DatePrepared String?       @db.NVarChar(50)
  DocOrigin_Id Int?
  DocOrigin    DocOrigins?   @relation(fields: [DocOrigin_Id], references: [Id])
  DocType      String?       @db.NVarChar(100)
  Particulars  String?       @db.NVarChar(Max)
  RoutedToPA   String?       @db.NVarChar(255)
  dtToPA       String?       @db.NVarChar(50)
  Rerouted     String?       @db.NVarChar(255)
  dtRerouted   String?       @db.NVarChar(50)
  dtFilling    String?       @db.NVarChar(50)
  FilingArea   String?       @db.NVarChar(255)
  Folder       String?       @db.NVarChar(255)
  DocStatus    String?       @db.NVarChar(100)
  OthInPhotos  OthInPhotos[]

  @@index([DocOrigin_Id])
  @@map("InComms")
}

model OutGoings {
  Id              Int            @id @default(autoincrement())
  DatePrepared    String?        @db.NVarChar(50)
  DocType         String?        @db.NVarChar(100)
  Particulars     String?        @db.NVarChar(Max)
  ReceivedBy      String?        @db.NVarChar(255)
  DateTrans       String?        @db.NVarChar(50)
  ResponPerson_Id Int?
  ResponPerson    ResponPersons? @relation(fields: [ResponPerson_Id], references: [Id])
  ActionNeeded    String?        @db.NVarChar(255)
  ActionTime      String?        @db.NVarChar(50)
  dtFilling       String?        @db.NVarChar(50)
  FilingArea      String?        @db.NVarChar(255)
  Folder          String?        @db.NVarChar(255)
  DocStatus       String?        @db.NVarChar(100)
  EncodedBy       String?        @db.NVarChar(255)
  OthOutPhotos    OthOutPhotos[]

  @@index([ResponPerson_Id])
  @@map("OutGoings")
}

// Photo Tables
model VouPhotos {
  Vou_Id     Int      @id @default(autoincrement())
  ImageFile  String   @db.NVarChar(500)
  Voucher_Id Int
  Voucher    Vouchers @relation(fields: [Voucher_Id], references: [Id], onDelete: Cascade)

  @@index([Voucher_Id])
  @@map("VouPhotos")
}

model OthInPhotos {
  In_Id     Int     @id @default(autoincrement())
  ImageFile String  @db.NVarChar(500)
  InComm_Id Int
  InComm    InComms @relation(fields: [InComm_Id], references: [Id], onDelete: Cascade)

  @@index([InComm_Id])
  @@map("OthInPhotos")
}

model OthOutPhotos {
  Out_Id      Int       @id @default(autoincrement())
  ImageFile   String    @db.NVarChar(500)
  OutGoing_Id Int
  OutGoing    OutGoings @relation(fields: [OutGoing_Id], references: [Id], onDelete: Cascade)

  @@index([OutGoing_Id])
  @@map("OthOutPhotos")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// User Management
model Users {
  Id           Int        @id @default(autoincrement()) @map("user_id")
  FirstName    String     @db.VarChar(255) @map("first_name")
  LastName     String     @db.VarChar(255) @map("last_name")
  EmployeeId   String     @db.VarChar(100) @map("employee_id")
  PasswordHash String     @db.VarChar(255) @map("password_hash")
  Section      String?    @db.VarChar(255) @map("section")
  Role         String?    @db.VarChar(100) @map("role")
  MobileNo     String    @db.VarChar(255) @map("mobile_number")
  Email        String    @db.VarChar(255) @map("email")
  IsActive     Boolean    @default(true) @map("is_active")
  DateAdded    DateTime   @default(now()) @db.DateTime @map("date_added")
  LastLogin    DateTime?  @db.DateTime @map("last_login")

  // Relations for Vouchers
  VouchersAdded        Vouchers[] @relation("VoucherAddedBy")
  VouchersModified     Vouchers[] @relation("VoucherModifiedBy")
  VoucherImagesAdded   VoucherImages[] @relation("VoucherImageAddedBy")
  DocumentImagesAdded  DocumentImages[] @relation("DocumentImageAddedBy")
  AuditLogs            AuditLog[]

  // Relations for Communications
  CommsCreated             Communication[]     @relation("CommCreatedBy")
  CommImagesUploaded       CommImage[]          @relation("CommImageUploadedBy")
  CommActionsCompleted     CommAction[]         @relation("CommActionCompletedBy")
  CommRoutingsRouted       CommRouting[]        @relation("CommRoutingRoutedBy")
  CommActionAssignees      CommActionAssignee[] @relation("CommActionAssigneeUser")
  CommActionReplies        CommActionReply[]    @relation("CommActionReplySender")
  CommReplyImages          CommActionReplyImage[] @relation("CommReplyImageUploader")

  // Relations for Chat
  ChatParticipants         ChatParticipant[]  @relation("ChatParticipantUser")
  ChatMessagesSent         ChatMessage[]      @relation("ChatMessageSender")

  // Relations for Index Documents
  IndexDocumentsAdded    IndexDocument[] @relation("IndexDocumentAddedBy")
  IndexDocumentsModified IndexDocument[] @relation("IndexDocumentModifiedBy")

  // Relations for Other Documents
  OtherDocumentsAdded    OtherDocument[] @relation("OtherDocumentAddedBy")
  OtherDocumentsModified OtherDocument[] @relation("OtherDocumentModifiedBy")

  @@map("users")
}

// Main Document Tables
model Vouchers {
  Id              Int         @id @default(autoincrement()) @map("voucher_id")
  VoucherNo       String      @db.VarChar(50) @map("voucher_no")
  TransactionNo   String?     @db.VarChar(50) @map("transaction_no")
  Payee           String      @db.VarChar(255) @map("payee")
  Particulars     String      @db.Text @map("particulars")
  ClaimType       String?     @db.VarChar(255) @map("claim_type")
  Amount          Decimal     @db.Decimal(18, 2) @map("amount")
  DateDisbursed   DateTime    @db.DateTime @map("date_disbursed")
  IsArchived      Boolean     @default(false) @map("is_archived")
  DateArchived    DateTime?   @db.DateTime @map("date_archived")
  DateAdded       DateTime    @default(now()) @db.DateTime @map("date_added")
  DateLastUpdated DateTime    @default(now()) @updatedAt @db.DateTime @map("date_last_updated")
  AddedById       Int?        @map("added_by")
  LastModifiedById Int?       @map("last_modified_by")

  // Relations
  AddedBy         Users?      @relation("VoucherAddedBy", fields: [AddedById], references: [Id])
  LastModifiedBy  Users?      @relation("VoucherModifiedBy", fields: [LastModifiedById], references: [Id])
  VoucherImages       VoucherImages[]
  DocumentImages      DocumentImages[]

  @@index([AddedById])
  @@index([LastModifiedById])
  @@map("vouchers")
}

// Photo Tables
model VoucherImages {
  Id            Int      @id @default(autoincrement()) @map("voucher_image_id")
  ImageFile     String   @db.VarChar(500) @map("image_file")
  ImageFileType String?  @db.VarChar(50) @map("image_file_type")
  ImageFileSize Int?     @map("image_file_size")
  VoucherId     Int      @map("voucher_id")
  EvidencedById Int?     @map("evidenced_by")

  // Relations
  Voucher       Vouchers @relation(fields: [VoucherId], references: [Id], onDelete: Cascade)
  EvidencedBy   Users?   @relation("VoucherImageAddedBy", fields: [EvidencedById], references: [Id])

  @@index([VoucherId])
  @@index([EvidencedById])
  @@map("voucher_images")
}

// Audit Logs
model AuditLog {
  Id         Int      @id @default(autoincrement()) @map("audit_log_id")
  EntityType String   @db.VarChar(50) @map("entity_type")
  EntityId   Int?     @map("entity_id")
  Action     String   @db.VarChar(50) @map("action")
  UserId     Int?     @map("user_id")
  Changes    String?  @db.LongText @map("changes")
  IpAddress  String?  @db.VarChar(45) @map("ip_address")
  Timestamp  DateTime @default(now()) @db.DateTime @map("timestamp")

  User       Users?   @relation(fields: [UserId], references: [Id])

  @@index([EntityType, EntityId])
  @@index([UserId])
  @@index([Timestamp])
  @@map("audit_logs")
}

// Index Document
model IndexDocument {
  Id         Int      @id @default(autoincrement()) @map("index_document_id")
  Payee     String   @db.VarChar(191) @map("payee")
  Particulars    String  @db.LongText @map("particulars")
  period_start  DateTime  @db.DateTime @map("period_start")
  period_end  DateTime  @db.DateTime @map("period_end")
  DateArchived    DateTime   @default(now()) @db.DateTime @map("date_archived")
  DateLastUpdated DateTime    @default(now()) @updatedAt @db.DateTime @map("date_last_updated")
  AddedById       Int        @map("added_by")
  LastModifiedById Int?       @map("last_modified_by")

  ShelfItemId     Int?       @map("shelf_item_id")

  // Relations
  AddedBy         Users?      @relation("IndexDocumentAddedBy", fields: [AddedById], references: [Id])
  LastModifiedBy  Users?      @relation("IndexDocumentModifiedBy", fields: [LastModifiedById], references: [Id])
  ShelfItem       ShelfItem?  @relation(fields: [ShelfItemId], references: [Id])
  DocumentImages  DocumentImages[]

  @@index([Payee])
  @@index([period_start, period_end])
  @@index([AddedById])
  @@index([LastModifiedById])
  @@index([ShelfItemId])
  @@map("index_document")
}

// Document Images (shared table for vouchers, index documents, and future document types)
model DocumentImages {
  Id              Int      @id @default(autoincrement()) @map("document_image_id")
  ImageFile       String   @db.VarChar(500) @map("image_file")
  ImageFileType   String?  @db.VarChar(50) @map("image_file_type")
  ImageFileSize   Int?     @map("image_file_size")
  VoucherId       Int?     @map("voucher_id")
  IndexDocumentId Int?     @map("index_document_id")
  OtherDocumentId   Int?     @map("other_document_id")
  EvidencedById   Int?     @map("evidenced_by")

  // Relations
  Voucher         Vouchers?      @relation(fields: [VoucherId], references: [Id], onDelete: Cascade)
  IndexDocument   IndexDocument? @relation(fields: [IndexDocumentId], references: [Id], onDelete: Cascade)
  OtherDocument     OtherDocument? @relation(fields: [OtherDocumentId], references: [Id], onDelete: Cascade)
  EvidencedBy     Users?         @relation("DocumentImageAddedBy", fields: [EvidencedById], references: [Id])

  @@index([VoucherId])
  @@index([IndexDocumentId])
  @@index([OtherDocumentId])
  @@index([EvidencedById])
  @@map("document_images")
}

// Locations (configurable building, floor, room with parent-child hierarchy)
model Location {
  Id          Int         @id @default(autoincrement()) @map("location_id")
  Name        String      @db.VarChar(120) @map("name")
  Type        String      @db.VarChar(50) @map("type")
  ParentId    Int?        @map("parent_id")
  DateCreated DateTime    @default(now()) @db.DateTime @map("date_created")

  Parent      Location?   @relation("LocationHierarchy", fields: [ParentId], references: [Id])
  Children    Location[]  @relation("LocationHierarchy")

  CabinetsAsBuilding  Cabinet[] @relation("CabinetBuilding")
  CabinetsAsFloor     Cabinet[] @relation("CabinetFloor")
  CabinetsAsRoom      Cabinet[] @relation("CabinetRoom")

  @@unique([Name, Type, ParentId])
  @@index([Type])
  @@index([ParentId])
  @@map("locations")
}

// Shelf Map - Cabinets
model Cabinet {
  Id              Int         @id @default(autoincrement()) @map("cabinet_id")
  Name            String      @db.VarChar(255) @map("name")
  Color           String      @db.VarChar(50) @map("color")
  BuildingId      Int?        @map("building_id")
  FloorId         Int?        @map("floor_id")
  RoomId          Int?        @map("room_id")
  X               Float       @default(0) @map("x")
  Y               Float       @default(0) @map("y")
  Width           Float       @default(100) @map("width")
  Height          Float       @default(60) @map("height")
  DateCreated     DateTime    @default(now()) @db.DateTime @map("date_created")
  DateLastUpdated DateTime    @default(now()) @updatedAt @db.DateTime @map("date_last_updated")

  Building        Location?   @relation("CabinetBuilding", fields: [BuildingId], references: [Id])
  Floor           Location?   @relation("CabinetFloor", fields: [FloorId], references: [Id])
  Room            Location?   @relation("CabinetRoom", fields: [RoomId], references: [Id])
  Shelves         Shelf[]

  @@index([BuildingId])
  @@index([FloorId])
  @@index([RoomId])
  @@map("cabinets")
}

// Shelf Map - Shelves
model Shelf {
  Id              Int         @id @default(autoincrement()) @map("shelf_id")
  Name            String      @db.VarChar(255) @map("name")
  Location        String?     @db.VarChar(255) @map("location")
  CabinetId       Int         @map("cabinet_id")
  DateCreated     DateTime    @default(now()) @db.DateTime @map("date_created")
  DateLastUpdated DateTime    @default(now()) @updatedAt @db.DateTime @map("date_last_updated")

  Cabinet         Cabinet     @relation(fields: [CabinetId], references: [Id], onDelete: Cascade)
  Items           ShelfItem[]

  @@index([CabinetId])
  @@map("shelves")
}

// Shelf Map - Items
model ShelfItem {
  Id              Int         @id @default(autoincrement()) @map("shelf_item_id")
  Label           String      @db.VarChar(255) @map("label")
  Description     String?     @db.Text @map("description")
  Category        String      @db.VarChar(191) @map("category")
  ShelfId         Int         @map("shelf_id")
  DateCreated     DateTime    @default(now()) @db.DateTime @map("date_created")
  DateLastUpdated DateTime    @default(now()) @updatedAt @db.DateTime @map("date_last_updated")

  Shelf           Shelf       @relation(fields: [ShelfId], references: [Id], onDelete: Cascade)
  IndexDocuments  IndexDocument[]
  OtherDocuments  OtherDocument[]

  @@index([ShelfId])
  @@index([Category])
  @@map("shelf_items")
}

// Maintenance Configuration (single-row table)
model MaintenanceConfig {
  Id          Int      @id @default(1) @map("config_id")
  IsActive    Boolean  @default(false) @map("is_active")
  Message     String   @default("The system is currently under maintenance. Please try again later.") @db.VarChar(500) @map("message")
  UpdatedAt   DateTime @default(now()) @updatedAt @db.DateTime @map("updated_at")

  @@map("maintenance_config")
}

// Other Document
model OtherDocument {
  Id         Int      @id @default(autoincrement()) @map("other_document_id")
  Title     String   @db.VarChar(100) @map("title")
  Particulars    String  @db.LongText @map("particulars")
  DateArchived    DateTime   @default(now()) @db.DateTime @map("date_archived")
  DateLastUpdated DateTime    @default(now()) @updatedAt @db.DateTime @map("date_last_updated")
  AddedById       Int        @map("added_by")
  LastModifiedById Int?       @map("last_modified_by")

  ShelfItemId     Int?       @map("shelf_item_id")

  // Relations
  AddedBy         Users?      @relation("OtherDocumentAddedBy", fields: [AddedById], references: [Id])
  LastModifiedBy  Users?      @relation("OtherDocumentModifiedBy", fields: [LastModifiedById], references: [Id])
  ShelfItem       ShelfItem?  @relation(fields: [ShelfItemId], references: [Id])
  DocumentImages  DocumentImages[]

  @@index([AddedById])
  @@index([LastModifiedById])
  @@index([DateArchived])
  @@index([ShelfItemId])
  @@map("general_document")
}

// Communications Logging
model Communication {
  Id              Int         @id @default(autoincrement()) @map("comm_id")
  Type            String      @db.VarChar(20) @map("type")
  ReferenceNumber String      @db.VarChar(50) @map("reference_number")
  Subject         String      @db.VarChar(500) @map("subject")
  Description     String?     @db.Text @map("description")
  Sender          String      @db.VarChar(255) @map("sender")
  Recipient       String      @db.VarChar(255) @map("recipient")
  DateReceived    DateTime    @db.DateTime @map("date_received")
  Status          String      @default("pending") @db.VarChar(20) @map("status")
  Priority        String      @default("normal") @db.VarChar(20) @map("priority")
  CreatedById     Int         @map("created_by")
  CreatedAt       DateTime    @default(now()) @db.DateTime @map("created_at")
  UpdatedAt       DateTime    @default(now()) @updatedAt @db.DateTime @map("updated_at")

  CreatedBy       Users       @relation("CommCreatedBy", fields: [CreatedById], references: [Id])
  Images          CommImage[]
  Actions         CommAction[]
  Routings        CommRouting[]

  @@index([Type])
  @@index([Status])
  @@index([CreatedById])
  @@index([DateReceived])
  @@map("communications")
}

model CommImage {
  Id              Int     @id @default(autoincrement()) @map("image_id")
  CommunicationId Int    @map("comm_id")
  ImageFile       String @db.VarChar(500) @map("image_file")
  ImageFileType   String? @db.VarChar(50) @map("image_file_type")
  ImageFileSize   Int?   @map("image_file_size")
  UploadedById    Int?   @map("uploaded_by")

  Communication   Communication @relation(fields: [CommunicationId], references: [Id], onDelete: Cascade)
  UploadedBy      Users?        @relation("CommImageUploadedBy", fields: [UploadedById], references: [Id])

  @@index([CommunicationId])
  @@map("comm_images")
}

model CommAction {
  Id              Int         @id @default(autoincrement()) @map("action_id")
  CommunicationId Int         @map("comm_id")
  ActionRequired  String      @db.Text @map("action_required")
  DueDate         DateTime    @db.DateTime @map("due_date")
  Status          String      @default("pending") @db.VarChar(20) @map("status")
  CompletedAt     DateTime?   @db.DateTime @map("completed_at")
  CompletedById   Int?        @map("completed_by")
  Notes           String?     @db.Text @map("notes")

  Communication   Communication          @relation(fields: [CommunicationId], references: [Id], onDelete: Cascade)
  CompletedBy     Users?                 @relation("CommActionCompletedBy", fields: [CompletedById], references: [Id])
  Assignees       CommActionAssignee[]
  Replies         CommActionReply[]

  @@index([CommunicationId])
  @@index([Status])
  @@map("comm_actions")
}

model CommActionAssignee {
  Id        Int     @id @default(autoincrement()) @map("assignee_id")
  ActionId  Int     @map("action_id")
  UserId    Int?    @map("user_id")
  Name      String? @db.VarChar(255) @map("name")

  Action    CommAction @relation(fields: [ActionId], references: [Id], onDelete: Cascade)
  User      Users?     @relation("CommActionAssigneeUser", fields: [UserId], references: [Id])

  @@index([ActionId])
  @@index([UserId])
  @@index([Name])
  @@map("comm_action_assignees")
}

model CommRouting {
  Id              Int         @id @default(autoincrement()) @map("routing_id")
  CommunicationId Int         @map("comm_id")
  RoutedTo        String      @db.Text @map("routed_to")
  RoutedToRole    String?     @db.VarChar(255) @map("routed_to_role")
  RoutedById      Int         @map("routed_by")
  RoutedAt        DateTime    @default(now()) @db.DateTime @map("routed_at")
  Remarks         String?     @db.Text @map("remarks")
  Acknowledged    Boolean     @default(false) @map("acknowledged")
  AcknowledgedAt  DateTime?   @db.DateTime @map("acknowledged_at")

  Communication   Communication @relation(fields: [CommunicationId], references: [Id], onDelete: Cascade)
  RoutedBy        Users         @relation("CommRoutingRoutedBy", fields: [RoutedById], references: [Id])

  @@index([CommunicationId])
  @@map("comm_routings")
}

// Action Item Reply Thread
model CommActionReply {
  Id        Int       @id @default(autoincrement()) @map("reply_id")
  ActionId  Int       @map("action_id")
  SenderId  Int       @map("sender_id")
  Content   String?   @db.Text @map("content")
  CreatedAt DateTime  @default(now()) @db.DateTime @map("created_at")

  Action    CommAction @relation(fields: [ActionId], references: [Id], onDelete: Cascade)
  Sender    Users      @relation("CommActionReplySender", fields: [SenderId], references: [Id])
  Images    CommActionReplyImage[]

  @@index([ActionId, CreatedAt])
  @@index([SenderId])
  @@map("comm_action_replies")
}

// Reply Image (stored on FTP)
model CommActionReplyImage {
  Id            Int     @id @default(autoincrement()) @map("image_id")
  ReplyId       Int     @map("reply_id")
  ImageFile     String  @db.VarChar(500) @map("image_file")
  ImageFileType String? @db.VarChar(50) @map("image_file_type")
  ImageFileSize Int?    @map("image_file_size")
  UploadedById  Int?    @map("uploaded_by")

  Reply         CommActionReply @relation(fields: [ReplyId], references: [Id], onDelete: Cascade)
  UploadedBy    Users?          @relation("CommReplyImageUploader", fields: [UploadedById], references: [Id])

  @@index([ReplyId])
  @@map("comm_action_reply_images")
}

// Chat Conversations (supports 1-to-1 and group chats)
model ChatConversation {
  Id        Int       @id @default(autoincrement()) @map("conversation_id")
  Name      String?   @db.VarChar(255) @map("name")
  IsGroup   Boolean   @default(false) @map("is_group")
  CreatedById Int?    @map("created_by")
  CreatedAt DateTime  @default(now()) @db.DateTime @map("created_at")
  UpdatedAt DateTime  @default(now()) @updatedAt @db.DateTime @map("updated_at")

  Participants ChatParticipant[]
  Messages     ChatMessage[]

  @@index([UpdatedAt])
  @@map("chat_conversations")
}

// Chat Participants (join table for conversation members)
model ChatParticipant {
  Id              Int       @id @default(autoincrement()) @map("participant_id")
  ConversationId  Int       @map("conversation_id")
  UserId          Int       @map("user_id")
  JoinedAt        DateTime  @default(now()) @db.DateTime @map("joined_at")

  Conversation    ChatConversation @relation(fields: [ConversationId], references: [Id], onDelete: Cascade)
  User            Users            @relation("ChatParticipantUser", fields: [UserId], references: [Id])

  @@unique([ConversationId, UserId])
  @@index([ConversationId])
  @@index([UserId])
  @@map("chat_participants")
}

// Chat Messages
model ChatMessage {
  Id              Int       @id @default(autoincrement()) @map("message_id")
  ConversationId  Int       @map("conversation_id")
  SenderId        Int       @map("sender_id")
  Content         String    @db.Text @map("content")
  CreatedAt       DateTime  @default(now()) @db.DateTime @map("created_at")
  ReadAt          DateTime? @db.DateTime @map("read_at")

  Conversation    ChatConversation @relation(fields: [ConversationId], references: [Id], onDelete: Cascade)
  Sender          Users            @relation("ChatMessageSender", fields: [SenderId], references: [Id])

  @@index([ConversationId, CreatedAt])
  @@index([SenderId])
  @@map("chat_messages")
}


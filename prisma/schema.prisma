generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Users {
  Id                         Int                    @id @default(autoincrement()) @map("user_id")
  FirstName                  String                 @map("first_name") @db.VarChar(255)
  LastName                   String                 @map("last_name") @db.VarChar(255)
  EmployeeId                 String                 @map("employee_id") @db.VarChar(100)
  PasswordHash               String                 @map("password_hash") @db.VarChar(255)
  DateAdded                  DateTime               @default(now()) @map("date_added") @db.DateTime(0)
  IsActive                   Boolean                @default(true) @map("is_active")
  LastLogin                  DateTime?              @map("last_login") @db.DateTime(0)
  Role                       String?                @map("role") @db.VarChar(100)
  Section                    String?                @map("section") @db.VarChar(255)
  MobileNo                   String                 @map("mobile_number") @db.VarChar(255)
  Email                      String                 @map("email") @db.VarChar(255)
  AnnouncementsCreated       Announcement[]         @relation("AnnouncementCreatedBy")
  AuditLogs                  AuditLog[]
  ChatMessagesSent           ChatMessage[]          @relation("ChatMessageSender")
  ChatParticipants           ChatParticipant[]      @relation("ChatParticipantUser")
  CommActionAssignees        CommActionAssignee[]   @relation("CommActionAssigneeUser")
  CommActionReplies          CommActionReply[]      @relation("CommActionReplySender")
  CommReplyImages            CommActionReplyImage[] @relation("CommReplyImageUploader")
  CommActionsCompleted       CommAction[]           @relation("CommActionCompletedBy")
  CommImagesUploaded         CommImage[]            @relation("CommImageUploadedBy")
  CommsArchived              Communication[]        @relation("CommArchivedBy")
  CommsCreated               Communication[]        @relation("CommCreatedBy")
  DocumentImagesAdded        DocumentImages[]       @relation("DocumentImageAddedBy")
  IndexDocumentsAdded        IndexDocument[]        @relation("IndexDocumentAddedBy")
  IndexDocumentsModified     IndexDocument[]        @relation("IndexDocumentModifiedBy")
  Notifications              Notification[]
  OtherDocumentsAdded        OtherDocument[]        @relation("OtherDocumentAddedBy")
  OtherDocumentsModified     OtherDocument[]        @relation("OtherDocumentModifiedBy")
  RecipientGroupMemberships  RecipientGroupMember[] @relation("RecipientGroupMemberUser")
  RecipientGroupsCreated     RecipientGroup[]       @relation("RecipientGroupCreatedBy")
  VoucherAgeingConfigUpdates VoucherAgeingConfig[]
  VoucherDeletionLogs        VoucherDeletionLog[]   @relation("VoucherDeletionLogDeletedBy")
  VoucherImagesAdded         VoucherImages[]        @relation("VoucherImageAddedBy")
  VouchersAdded              Vouchers[]             @relation("VoucherAddedBy")
  VouchersModified           Vouchers[]             @relation("VoucherModifiedBy")

  @@map("users")
}

model Vouchers {
  Id               Int              @id @default(autoincrement()) @map("voucher_id")
  VoucherNo        String           @map("voucher_no") @db.VarChar(50)
  TransactionNo    String?          @map("transaction_no") @db.VarChar(50)
  Payee            String           @map("payee") @db.VarChar(255)
  Particulars      String           @map("particulars") @db.Text
  ClaimType        String?          @map("claim_type") @db.VarChar(255)
  Amount           Decimal          @map("amount") @db.Decimal(18, 2)
  DateDisbursed    DateTime         @map("date_disbursed") @db.DateTime(0)
  DateAdded        DateTime         @default(now()) @map("date_added") @db.DateTime(0)
  DateLastUpdated  DateTime         @default(now()) @updatedAt @map("date_last_updated") @db.DateTime(0)
  AddedById        Int?             @map("added_by")
  LastModifiedById Int?             @map("last_modified_by")
  IsArchived       Boolean          @default(false) @map("is_archived")
  DateArchived     DateTime?        @map("date_archived") @db.DateTime(0)
  DocumentImages   DocumentImages[]
  VoucherImages    VoucherImages[]
  AddedBy          Users?           @relation("VoucherAddedBy", fields: [AddedById], references: [Id])
  LastModifiedBy   Users?           @relation("VoucherModifiedBy", fields: [LastModifiedById], references: [Id])

  @@index([AddedById])
  @@index([LastModifiedById])
  @@map("vouchers")
}

model VoucherDeletionLog {
  Id            Int      @id @default(autoincrement()) @map("id")
  VoucherNo     String   @map("voucher_no") @db.VarChar(50)
  TransactionNo String?  @map("transaction_no") @db.VarChar(50)
  Payee         String   @map("payee") @db.VarChar(255)
  Particulars   String   @map("particulars") @db.Text
  ClaimType     String?  @map("claim_type") @db.VarChar(255)
  Amount        Decimal  @map("amount") @db.Decimal(18, 2)
  DateDisbursed DateTime @map("date_disbursed") @db.DateTime(0)
  IsArchived    Boolean  @map("is_archived")
  DeleteReason  String   @map("delete_reason") @db.Text
  DeletedAt     DateTime @default(now()) @map("deleted_at") @db.DateTime(0)
  DeletedById   Int?     @map("deleted_by_id")
  DeletedBy     Users?   @relation("VoucherDeletionLogDeletedBy", fields: [DeletedById], references: [Id])

  @@index([DeletedById])
  @@map("voucher_deletion_log")
}

model VoucherImages {
  Id            Int      @id @default(autoincrement()) @map("voucher_image_id")
  ImageFile     String   @map("image_file") @db.VarChar(500)
  ImageFileType String?  @map("image_file_type") @db.VarChar(50)
  VoucherId     Int      @map("voucher_id")
  EvidencedById Int?     @map("evidenced_by")
  ImageFileSize Int?     @map("image_file_size")
  EvidencedBy   Users?   @relation("VoucherImageAddedBy", fields: [EvidencedById], references: [Id])
  Voucher       Vouchers @relation(fields: [VoucherId], references: [Id], onDelete: Cascade)

  @@index([VoucherId])
  @@index([EvidencedById])
  @@map("voucher_images")
}

model AuditLog {
  Id         Int      @id @default(autoincrement()) @map("audit_log_id")
  EntityType String   @map("entity_type") @db.VarChar(50)
  EntityId   Int?     @map("entity_id")
  Action     String   @map("action") @db.VarChar(50)
  UserId     Int?     @map("user_id")
  Changes    String?  @map("changes") @db.LongText
  IpAddress  String?  @map("ip_address") @db.VarChar(45)
  Timestamp  DateTime @default(now()) @map("timestamp") @db.DateTime(0)
  User       Users?   @relation(fields: [UserId], references: [Id])

  @@index([EntityType, EntityId])
  @@index([UserId])
  @@index([Timestamp])
  @@map("audit_logs")
}

model IndexDocument {
  Id               Int              @id @default(autoincrement()) @map("index_document_id")
  Payee            String           @map("payee")
  Particulars      String           @map("particulars") @db.LongText
  period_start     DateTime         @map("period_start") @db.DateTime(0)
  period_end       DateTime         @map("period_end") @db.DateTime(0)
  DateArchived     DateTime         @default(now()) @map("date_archived") @db.DateTime(0)
  DateLastUpdated  DateTime         @default(now()) @updatedAt @map("date_last_updated") @db.DateTime(0)
  AddedById        Int              @map("added_by")
  LastModifiedById Int?             @map("last_modified_by")
  ShelfItemId      Int?             @map("shelf_item_id")
  DocumentImages   DocumentImages[]
  AddedBy          Users            @relation("IndexDocumentAddedBy", fields: [AddedById], references: [Id])
  LastModifiedBy   Users?           @relation("IndexDocumentModifiedBy", fields: [LastModifiedById], references: [Id])
  ShelfItem        ShelfItem?       @relation(fields: [ShelfItemId], references: [Id])

  @@index([period_start, period_end])
  @@index([AddedById])
  @@index([LastModifiedById])
  @@index([ShelfItemId])
  @@map("index_document")
}

model DocumentImages {
  Id              Int            @id @default(autoincrement()) @map("document_image_id")
  ImageFile       String         @map("image_file") @db.VarChar(500)
  ImageFileType   String?        @map("image_file_type") @db.VarChar(50)
  ImageFileSize   Int?           @map("image_file_size")
  VoucherId       Int?           @map("voucher_id")
  IndexDocumentId Int?           @map("index_document_id")
  EvidencedById   Int?           @map("evidenced_by")
  OtherDocumentId Int?           @map("other_document_id")
  EvidencedBy     Users?         @relation("DocumentImageAddedBy", fields: [EvidencedById], references: [Id])
  IndexDocument   IndexDocument? @relation(fields: [IndexDocumentId], references: [Id], onDelete: Cascade)
  OtherDocument   OtherDocument? @relation(fields: [OtherDocumentId], references: [Id], onDelete: Cascade)
  Voucher         Vouchers?      @relation(fields: [VoucherId], references: [Id], onDelete: Cascade)

  @@index([VoucherId])
  @@index([IndexDocumentId])
  @@index([OtherDocumentId])
  @@index([EvidencedById])
  @@map("document_images")
}

model Location {
  Id                 Int        @id @default(autoincrement()) @map("location_id")
  Name               String     @map("name") @db.VarChar(120)
  Type               String     @map("type") @db.VarChar(50)
  ParentId           Int?       @map("parent_id")
  DateCreated        DateTime   @default(now()) @map("date_created") @db.DateTime(0)
  CabinetsAsBuilding Cabinet[]  @relation("CabinetBuilding")
  CabinetsAsFloor    Cabinet[]  @relation("CabinetFloor")
  CabinetsAsRoom     Cabinet[]  @relation("CabinetRoom")
  Parent             Location?  @relation("LocationHierarchy", fields: [ParentId], references: [Id])
  Children           Location[] @relation("LocationHierarchy")

  @@index([Type])
  @@index([ParentId])
  @@map("locations")
}

model Cabinet {
  Id              Int       @id @default(autoincrement()) @map("cabinet_id")
  Name            String    @map("name") @db.VarChar(255)
  Color           String    @map("color") @db.VarChar(50)
  X               Float     @default(0) @map("x")
  Y               Float     @default(0) @map("y")
  Width           Float     @default(100) @map("width")
  Height          Float     @default(60) @map("height")
  DateCreated     DateTime  @default(now()) @map("date_created") @db.DateTime(0)
  DateLastUpdated DateTime  @default(now()) @updatedAt @map("date_last_updated") @db.DateTime(0)
  BuildingId      Int?      @map("building_id")
  FloorId         Int?      @map("floor_id")
  RoomId          Int?      @map("room_id")
  Building        Location? @relation("CabinetBuilding", fields: [BuildingId], references: [Id])
  Floor           Location? @relation("CabinetFloor", fields: [FloorId], references: [Id])
  Room            Location? @relation("CabinetRoom", fields: [RoomId], references: [Id])
  Shelves         Shelf[]

  @@index([BuildingId])
  @@index([FloorId])
  @@index([RoomId])
  @@map("cabinets")
}

model Shelf {
  Id              Int         @id @default(autoincrement()) @map("shelf_id")
  Name            String      @map("name") @db.VarChar(255)
  Location        String?     @map("location") @db.VarChar(255)
  CabinetId       Int         @map("cabinet_id")
  DateCreated     DateTime    @default(now()) @map("date_created") @db.DateTime(0)
  DateLastUpdated DateTime    @default(now()) @updatedAt @map("date_last_updated") @db.DateTime(0)
  Items           ShelfItem[]
  Cabinet         Cabinet     @relation(fields: [CabinetId], references: [Id], onDelete: Cascade)

  @@index([CabinetId])
  @@map("shelves")
}

model ShelfItem {
  Id              Int             @id @default(autoincrement()) @map("shelf_item_id")
  Label           String          @map("label") @db.VarChar(255)
  Description     String?         @map("description") @db.Text
  Category        String          @map("category")
  ShelfId         Int             @map("shelf_id")
  DateCreated     DateTime        @default(now()) @map("date_created") @db.DateTime(0)
  DateLastUpdated DateTime        @default(now()) @updatedAt @map("date_last_updated") @db.DateTime(0)
  Communications  Communication[]
  IndexDocuments  IndexDocument[]
  OtherDocuments  OtherDocument[]
  Shelf           Shelf           @relation(fields: [ShelfId], references: [Id], onDelete: Cascade)

  @@index([ShelfId])
  @@map("shelf_items")
}

model MaintenanceConfig {
  Id        Int      @id @default(1) @map("config_id")
  IsActive  Boolean  @default(false) @map("is_active")
  Message   String   @default("The system is currently under maintenance. Please try again later.") @map("message") @db.VarChar(500)
  UpdatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("maintenance_config")
}

model VoucherAgeingConfig {
  Id            Int      @id @default(1) @map("config_id")
  ThresholdDays Int      @default(30) @map("threshold_days")
  UpdatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  UpdatedById   Int?     @map("updated_by_id")
  UpdatedBy     Users?   @relation(fields: [UpdatedById], references: [Id])

  @@index([UpdatedById], map: "voucher_ageing_config_updated_by_id_fkey")
  @@map("voucher_ageing_config")
}

model OtherDocumentType {
  Id             Int             @id @default(autoincrement()) @map("other_document_type_id")
  Type           String          @unique @map("type") @db.VarChar(100)
  Communications Communication[]
  OtherDocuments OtherDocument[]

  @@map("other_document_type")
}

model OtherDocument {
  Id               Int                @id @default(autoincrement()) @map("other_document_id")
  DocumentNo       String             @unique @map("document_no") @db.VarChar(20)
  Title            String             @map("title") @db.VarChar(100)
  Particulars      String             @map("particulars") @db.LongText
  DateArchived     DateTime           @default(now()) @map("date_archived") @db.DateTime(0)
  DateLastUpdated  DateTime           @default(now()) @updatedAt @map("date_last_updated") @db.DateTime(0)
  AddedById        Int                @map("added_by")
  LastModifiedById Int?               @map("last_modified_by")
  ShelfItemId      Int?               @map("shelf_item_id")
  DocumentTypeId   Int?               @map("document_type_id")
  DocumentImages   DocumentImages[]
  AddedBy          Users              @relation("OtherDocumentAddedBy", fields: [AddedById], references: [Id])
  DocumentType     OtherDocumentType? @relation(fields: [DocumentTypeId], references: [Id])
  LastModifiedBy   Users?             @relation("OtherDocumentModifiedBy", fields: [LastModifiedById], references: [Id])
  ShelfItem        ShelfItem?         @relation(fields: [ShelfItemId], references: [Id])

  @@index([DocumentTypeId])
  @@index([AddedById])
  @@index([LastModifiedById])
  @@index([DateArchived])
  @@index([ShelfItemId])
  @@map("other_document")
}

model Communication {
  Id              Int                @id @default(autoincrement()) @map("comm_id")
  Type            String             @map("type") @db.VarChar(20)
  ReferenceNumber String             @unique @map("reference_number") @db.VarChar(50)
  Subject         String             @map("subject") @db.VarChar(500)
  Description     String?            @map("description") @db.Text
  Sender          String             @map("sender") @db.VarChar(255)
  Recipient       String             @map("recipient") @db.VarChar(255)
  DateReceived    DateTime           @map("date_received") @db.DateTime(0)
  Status          String             @default("pending") @map("status") @db.VarChar(20)
  Priority        String             @default("normal") @map("priority") @db.VarChar(20)
  CreatedById     Int                @map("created_by")
  CreatedAt       DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  UpdatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  DateSent        DateTime?          @map("date_sent") @db.DateTime(0)
  ArchivedAt      DateTime?          @map("archived_at") @db.DateTime(0)
  ArchivedById    Int?               @map("archived_by")
  IsArchived      Boolean            @default(false) @map("is_archived")
  ShelfItemId     Int?               @map("shelf_item_id")
  DocumentTypeId  Int?               @map("document_type_id")
  Actions         CommAction[]
  Images          CommImage[]
  ArchivedBy      Users?             @relation("CommArchivedBy", fields: [ArchivedById], references: [Id])
  CreatedBy       Users              @relation("CommCreatedBy", fields: [CreatedById], references: [Id])
  DocumentType    OtherDocumentType? @relation(fields: [DocumentTypeId], references: [Id])
  ShelfItem       ShelfItem?         @relation(fields: [ShelfItemId], references: [Id])
  LinksAsA        CommunicationLink[] @relation("CommLinkA")
  LinksAsB        CommunicationLink[] @relation("CommLinkB")

  @@index([Type])
  @@index([Status])
  @@index([CreatedById])
  @@index([DateReceived])
  @@index([DocumentTypeId])
  @@index([ArchivedById], map: "communications_archived_by_fkey")
  @@index([ShelfItemId], map: "communications_shelf_item_id_fkey")
  @@map("communications")
}

model Party {
  Id        Int      @id @default(autoincrement()) @map("party_id")
  Name      String   @map("name") @db.VarChar(255)
  ShortName String?  @map("short_name") @db.VarChar(100)
  Type      String   @default("organization") @map("type") @db.VarChar(50)
  IsActive  Boolean  @default(true) @map("is_active")
  CreatedAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  UpdatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("parties")
}

model CommunicationLink {
  CommAId    Int           @map("comm_a_id")
  CommBId    Int           @map("comm_b_id")
  CreatedAt  DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  CommA      Communication @relation("CommLinkA", fields: [CommAId], references: [Id], onDelete: Cascade)
  CommB      Communication @relation("CommLinkB", fields: [CommBId], references: [Id], onDelete: Cascade)

  @@id([CommAId, CommBId])
  @@index([CommBId])
  @@map("communication_links")
}

model CommImage {
  Id              Int           @id @default(autoincrement()) @map("image_id")
  CommunicationId Int           @map("comm_id")
  ImageFile       String        @map("image_file") @db.VarChar(500)
  ImageFileType   String?       @map("image_file_type") @db.VarChar(50)
  ImageFileSize   Int?          @map("image_file_size")
  UploadedById    Int?          @map("uploaded_by")
  Communication   Communication @relation(fields: [CommunicationId], references: [Id], onDelete: Cascade)
  UploadedBy      Users?        @relation("CommImageUploadedBy", fields: [UploadedById], references: [Id])

  @@index([CommunicationId])
  @@index([UploadedById], map: "comm_images_uploaded_by_fkey")
  @@map("comm_images")
}

model CommAction {
  Id              Int                  @id @default(autoincrement()) @map("action_id")
  CommunicationId Int                  @map("comm_id")
  ActionRequired  String               @map("action_required") @db.Text
  DueDate         DateTime?            @map("due_date") @db.DateTime(0)
  Status          String               @default("pending") @map("status") @db.VarChar(20)
  CompletedAt     DateTime?            @map("completed_at") @db.DateTime(0)
  CompletedById   Int?                 @map("completed_by")
  Notes           String?              @map("notes") @db.Text
  CreatedAt       DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  Assignees       CommActionAssignee[]
  Replies         CommActionReply[]
  Communication   Communication        @relation(fields: [CommunicationId], references: [Id], onDelete: Cascade)
  CompletedBy     Users?               @relation("CommActionCompletedBy", fields: [CompletedById], references: [Id])

  @@index([CommunicationId])
  @@index([Status])
  @@index([CompletedById], map: "comm_actions_completed_by_fkey")
  @@map("comm_actions")
}

model CommActionAssignee {
  Id       Int        @id @default(autoincrement()) @map("assignee_id")
  ActionId Int        @map("action_id")
  UserId   Int?       @map("user_id")
  Name     String?    @map("name") @db.VarChar(255)
  Action   CommAction @relation(fields: [ActionId], references: [Id], onDelete: Cascade)
  User     Users?     @relation("CommActionAssigneeUser", fields: [UserId], references: [Id])

  @@index([ActionId])
  @@index([UserId])
  @@map("comm_action_assignees")
}

model CommActionReply {
  Id        Int                    @id @default(autoincrement()) @map("reply_id")
  ActionId  Int                    @map("action_id")
  SenderId  Int                    @map("sender_id")
  Content   String?                @map("content") @db.Text
  CreatedAt DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  Action    CommAction             @relation(fields: [ActionId], references: [Id], onDelete: Cascade)
  Sender    Users                  @relation("CommActionReplySender", fields: [SenderId], references: [Id])
  Images    CommActionReplyImage[]

  @@index([ActionId, CreatedAt])
  @@index([SenderId])
  @@map("comm_action_replies")
}

model CommActionReplyImage {
  Id            Int             @id @default(autoincrement()) @map("image_id")
  ReplyId       Int             @map("reply_id")
  ImageFile     String          @map("image_file") @db.VarChar(500)
  ImageFileType String?         @map("image_file_type") @db.VarChar(50)
  ImageFileSize Int?            @map("image_file_size")
  UploadedById  Int?            @map("uploaded_by")
  Reply         CommActionReply @relation(fields: [ReplyId], references: [Id], onDelete: Cascade)
  UploadedBy    Users?          @relation("CommReplyImageUploader", fields: [UploadedById], references: [Id])

  @@index([ReplyId])
  @@index([UploadedById], map: "comm_action_reply_images_uploaded_by_fkey")
  @@map("comm_action_reply_images")
}

model ChatConversation {
  Id           Int               @id @default(autoincrement()) @map("conversation_id")
  Name         String?           @map("name") @db.VarChar(255)
  IsGroup      Boolean           @default(false) @map("is_group")
  CreatedById  Int?              @map("created_by")
  CreatedAt    DateTime          @default(now()) @map("created_at") @db.DateTime(0)
  UpdatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  Messages     ChatMessage[]
  Participants ChatParticipant[]

  @@index([UpdatedAt])
  @@map("chat_conversations")
}

model ChatParticipant {
  Id             Int              @id @default(autoincrement()) @map("participant_id")
  ConversationId Int              @map("conversation_id")
  UserId         Int              @map("user_id")
  JoinedAt       DateTime         @default(now()) @map("joined_at") @db.DateTime(0)
  Conversation   ChatConversation @relation(fields: [ConversationId], references: [Id], onDelete: Cascade)
  User           Users            @relation("ChatParticipantUser", fields: [UserId], references: [Id])

  @@unique([ConversationId, UserId])
  @@index([ConversationId])
  @@index([UserId])
  @@map("chat_participants")
}

model Notification {
  Id         Int      @id @default(autoincrement()) @map("notification_id")
  UserId     Int      @map("user_id")
  Type       String   @map("type") @db.VarChar(50)
  Title      String   @map("title") @db.VarChar(255)
  Body       String   @map("body") @db.Text
  EntityType String?  @map("entity_type") @db.VarChar(50)
  EntityId   Int?     @map("entity_id")
  IsRead     Boolean  @default(false) @map("is_read")
  CreatedAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)
  User       Users    @relation(fields: [UserId], references: [Id], onDelete: Cascade)

  @@index([UserId, IsRead])
  @@index([CreatedAt])
  @@map("notifications")
}

model ChatMessage {
  Id             Int              @id @default(autoincrement()) @map("message_id")
  ConversationId Int              @map("conversation_id")
  SenderId       Int              @map("sender_id")
  Content        String           @map("content") @db.Text
  CreatedAt      DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  ReadAt         DateTime?        @map("read_at") @db.DateTime(0)
  Conversation   ChatConversation @relation(fields: [ConversationId], references: [Id], onDelete: Cascade)
  Sender         Users            @relation("ChatMessageSender", fields: [SenderId], references: [Id])

  @@index([ConversationId, CreatedAt])
  @@index([SenderId])
  @@map("chat_messages")
}

model RecipientGroup {
  Id          Int                    @id @default(autoincrement()) @map("group_id")
  Name        String                 @map("name") @db.VarChar(255)
  Status      String                 @default("active") @map("status") @db.VarChar(20)
  Version     Int                    @default(1) @map("version")
  GroupKey    String                 @map("group_key") @db.VarChar(100)
  CreatedById Int                    @map("created_by")
  CreatedAt   DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  Members     RecipientGroupMember[]
  CreatedBy   Users                  @relation("RecipientGroupCreatedBy", fields: [CreatedById], references: [Id])

  @@index([Status])
  @@index([CreatedById])
  @@map("recipient_groups")
}

model RecipientGroupMember {
  Id      Int            @id @default(autoincrement()) @map("member_id")
  GroupId Int            @map("group_id")
  UserId  Int            @map("user_id")
  Group   RecipientGroup @relation(fields: [GroupId], references: [Id], onDelete: Cascade)
  User    Users          @relation("RecipientGroupMemberUser", fields: [UserId], references: [Id])

  @@unique([GroupId, UserId])
  @@index([GroupId])
  @@index([UserId])
  @@map("recipient_group_members")
}

model RolePermission {
  Id        Int      @id @default(autoincrement()) @map("id")
  Role      String   @map("role") @db.VarChar(100)
  Resource  String   @map("resource") @db.VarChar(100)
  Action    String   @map("action") @db.VarChar(50)
  Allowed   Boolean  @default(true) @map("allowed")
  UpdatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([Role, Resource, Action])
  @@index([Role])
  @@map("role_permissions")
}

model Announcement {
  Id            Int       @id @default(autoincrement()) @map("announcement_id")
  Title         String    @map("title") @db.VarChar(255)
  Content       String    @map("content") @db.Text
  Category      String    @default("general") @map("category") @db.VarChar(50)
  Priority      String    @default("normal") @map("priority") @db.VarChar(20)
  Status        String    @default("draft") @map("status") @db.VarChar(20)
  StartDate     DateTime? @map("start_date") @db.DateTime(0)
  EndDate       DateTime? @map("end_date") @db.DateTime(0)
  CreatedById   Int       @map("created_by")
  CreatedAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  UpdatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  IsDismissible Boolean   @default(true) @map("is_dismissible")
  CreatedBy     Users     @relation("AnnouncementCreatedBy", fields: [CreatedById], references: [Id])

  @@index([Status])
  @@index([Category])
  @@index([CreatedById])
  @@index([StartDate, EndDate])
  @@map("announcements")
}
